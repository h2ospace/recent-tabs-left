{
  "manifest_version": 3,
  "name": "Recent Tabs Left",
  "version": "1.2.0",
  "description": "タブを設定した秒数見ると、一番左（固定タブの右）へ移動します。",
  "permissions": ["tabs", "storage", "alarms"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Recent Tabs Left の設定",
    "default_popup": "options.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
