{
  "manifest_version": 3,
  "name": "Tabs Stay Left",
  "version": "1.4.0",
  "description": "オンのとき新しいタブは左端で開きます。見続けたタブも左へ移動し、同じURLは既存タブを使います。上限超過で右端を閉じます。",
  "permissions": ["tabs", "storage", "alarms", "webNavigation"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Tabs Stay Left: オン（クリックでオフ）",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
