{
  "manifest_version": 3,
  "name": "Recent Tabs Left",
  "version": "1.3.0",
  "description": "タブを設定した秒数見ると左へ移動します。同じURLは開いているタブを使います。",
  "permissions": ["tabs", "storage", "alarms", "webNavigation"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Recent Tabs Left の設定",
    "default_popup": "options.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
